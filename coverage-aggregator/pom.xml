<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>java-for-arduino</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>coverage-aggregator</artifactId>
    <packaging>jar</packaging>
    <name>Coverage Aggregator</name>
    <description>Aggregates the JaCoCo execution data of every Juno module into one report</description>

    <!-- Declares the modules whose execution data is aggregated; it contributes no classes of its own. -->
    <dependencies>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-maven-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-rcx-firmware</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-bearssl</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze-dependencies</id>
                        <configuration>
                            <!-- The aggregator declares the modules on purpose: it uses none of their classes directly. -->
                            <ignoredUnusedDeclaredDependencies>
                                <ignoredUnusedDeclaredDependency>io.github.jabrena:juno-api</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>io.github.jabrena:juno-compiler</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>io.github.jabrena:juno-maven-plugin</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>io.github.jabrena:juno-rcx-firmware</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>io.github.jabrena:juno-bearssl</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${maven-plugin-jacoco.version}</version>
                <executions>
                    <execution>
                        <id>merge-exec</id>
                        <!-- Before verify: the inherited check execution also runs in verify and reads this file. -->
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>*/target/jacoco.exec</include>
                                        <include>juno-third-parties/*/target/jacoco.exec</include>
                                    </includes>
                                    <excludes>
                                        <exclude>juno-examples/**</exclude>
                                        <exclude>juno-site/**</exclude>
                                        <exclude>coverage-aggregator/**</exclude>
                                    </excludes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                    <limit>
                                        <counter>BRANCH</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                    <limit>
                                        <counter>METHOD</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                    <limit>
                                        <counter>CLASS</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                    <limit>
                                        <counter>INSTRUCTION</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                    <limit>
                                        <counter>COMPLEXITY</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${coverage.level}%</minimum>
                                    </limit>
                                </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-site-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing across the modules: ./mvnw verify -Ppitest -fae writes one PIT report for every module
             that ran mutationCoverage, and gates the combined score on coverage.level. This module has no tests of
             its own, so it skips the per-module mutationCoverage that the root profile adds. -->
        <profile>
            <id>pitest</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${maven-plugin-pitest.version}</version>
                        <executions>
                            <execution>
                                <id>pitest-mutation-testing</id>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pitest-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <aggregatedMutationThreshold>${coverage.level}</aggregatedMutationThreshold>
                                    <outputFormats>
                                        <outputFormat>HTML</outputFormat>
                                        <outputFormat>XML</outputFormat>
                                    </outputFormats>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
