<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="jlsSection">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]+(\.[0-9]+)+"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Every skipped JLS section states why it is skipped: a gap in the catalog, a clause owned by another
         category, or a clause outside the runtime suite. The category is what makes the percentage readable. -->
    <xs:simpleType name="skipReason">
        <xs:restriction base="xs:string">
            <xs:pattern value="(Gap|Other category|Out of scope): .+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="catalog">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="programs">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="program" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="id" type="xs:ID" use="required"/>
                                    <xs:attribute name="source" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:pattern value="programs/.+\.java"/>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!-- The backends the suite runs on, defined once. Each area refers to them by id. -->
                <xs:element name="backends">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="backend" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="id" type="xs:ID" use="required"/>
                                    <xs:attribute name="title" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!-- The full JLS section list of each category. The percentage of covered sections is measured
                     against these lists, so a section that no area mentions is still counted as missing. -->
                <xs:element name="scopes">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="scope" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="jls" minOccurs="1" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="section" type="jlsSection" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:ID" use="required"/>
                                    <xs:attribute name="title" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="areas">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="area" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="jls" minOccurs="1" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="section" type="jlsSection" use="required"/>
                                                <!-- Absent means covered by the programs of this area. -->
                                                <xs:attribute name="skipped" type="xs:boolean" default="false"/>
                                                <!-- Required when skipped="true" (checked by the catalog loader). -->
                                                <xs:attribute name="reason" type="skipReason"/>
                                            </xs:complexType>
                                        </xs:element>
                                        <!-- An area with only skipped sections has no programs yet. -->
                                        <xs:element name="program" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="ref" type="xs:IDREF" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                        <!-- Exactly one status per required backend (thumb2, avr, xtensa). -->
                                        <xs:element name="backend" minOccurs="3" maxOccurs="3">
                                            <xs:complexType>
                                                <xs:attribute name="ref" type="xs:IDREF" use="required"/>
                                                <xs:attribute name="status" use="required">
                                                    <xs:simpleType>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="REQUIRED"/>
                                                            <xs:enumeration value="OPTIONAL"/>
                                                            <xs:enumeration value="UNSUPPORTED"/>
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:ID" use="required"/>
                                    <xs:attribute name="title" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="schemaVersion" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="javaRelease" type="xs:positiveInteger" use="required"/>
            <xs:attribute name="jlsBaseUrl" type="xs:anyURI" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
