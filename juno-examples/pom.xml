<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>java-for-arduino</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juno-examples</artifactId>
    <name>Juno Examples</name>
    <description>Example Java programs demonstrating the Juno hardware API</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <juno.main>io.github.jabrena.juno.api.Blink</juno.main>
        <juno.envFile>${maven.multiModuleProjectDirectory}/.env</juno.envFile>
        <!-- ArduinoCliCompileTest needs Docker; it runs only with -Parduino-cli. -->
        <juno.test.groups></juno.test.groups>
        <juno.test.excludedGroups>arduino-cli</juno.test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${juno.test.groups}</groups>
                    <excludedGroups>${juno.test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.jabrena</groupId>
                <artifactId>juno-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <mainClass>${juno.main}</mainClass>
                    <envFile>${juno.envFile}</envFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>env</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Compile every TFT game with the real arduino-cli in Docker: ./mvnw -f juno-examples/pom.xml -Parduino-cli test -->
        <profile>
            <id>arduino-cli</id>
            <properties>
                <juno.test.groups>arduino-cli</juno.test.groups>
                <juno.test.excludedGroups></juno.test.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
