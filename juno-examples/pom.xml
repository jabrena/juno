<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>java-for-arduino</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juno-examples</artifactId>
    <name>Juno Arduino Examples</name>
    <description>Example Java programs demonstrating the Juno hardware API</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- Board programs run on hardware; the JaCoCo gate in the root pom does not apply to them. -->
        <jacoco.skip>true</jacoco.skip>
        <!-- Same for PIT: the root -Ppitest profile skips the board programs. -->
        <skipPitest>true</skipPitest>
        <juno.main>io.github.jabrena.juno.api.Blink</juno.main>
        <juno.envFile>${maven.multiModuleProjectDirectory}/.env</juno.envFile>
        <kotlin.version>2.2.20</kotlin.version>
        <scala.version>3.10.0</scala.version>
        <scala-maven-plugin.version>4.10.0</scala-maven-plugin.version>
        <clojure.version>1.12.0</clojure.version>
        <exec-maven-plugin.version>3.5.1</exec-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-rcx-firmware</artifactId>
        </dependency>
        <!-- Kotlin examples compile against the Juno API only; the stdlib is needed at build time, never on the board. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Nullability annotations are never read by the board toolchain; the class is Java 5 bytecode Juno rejects. -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Scala examples compile against the Juno API only; the Scala library is needed at build time, never on the board. -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Declared because the examples' classes reference it (ModuleSerializationProxy); dependency:analyze requires it. -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>${scala.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Clojure examples compile against the Juno API only; the Clojure runtime is needed at build time (AOT), never on the board. -->
        <dependency>
            <groupId>org.clojure</groupId>
            <artifactId>clojure</artifactId>
            <version>${clojure.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Tests drive the compiler directly (JunoCompiler, CompilationRequest) on the example classes. -->
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-compiler</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Only LanguageExamplesArduinoCliIT (the arduino-cli profile) uses these; versions come from the root pom. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Pulled in through duct-tape: compile-time nullability annotations the test runtime never reads. -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Eclipse m2e does not provide lifecycle mappings for these build-time language/tooling goals. -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.jetbrains.kotlin</groupId>
                                        <artifactId>kotlin-maven-plugin</artifactId>
                                        <versionRange>2.2.20</versionRange>
                                        <goals>
                                            <goal>compile</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore />
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>net.alchim31.maven</groupId>
                                        <artifactId>scala-maven-plugin</artifactId>
                                        <versionRange>4.9.9</versionRange>
                                        <goals>
                                            <goal>compile</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore />
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.codehaus.mojo</groupId>
                                        <artifactId>exec-maven-plugin</artifactId>
                                        <versionRange>3.5.1</versionRange>
                                        <goals>
                                            <goal>java</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore />
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>io.github.jabrena</groupId>
                                        <artifactId>juno-maven-plugin</artifactId>
                                        <versionRange>0.1.0-SNAPSHOT</versionRange>
                                        <goals>
                                            <goal>env</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore />
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                    </sourceDirs>
                    <jvmTarget>24</jvmTarget>
                    <args>
                        <!-- Keep the bytecode Juno lowers free of kotlin.jvm.internal.Intrinsics calls. -->
                        <arg>-Xno-param-assertions</arg>
                        <arg>-Xno-call-assertions</arg>
                        <arg>-Xno-receiver-assertions</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-kotlin</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala-maven-plugin.version}</version>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <args>
                        <!-- Scala examples are Java 27 bytecode, the same release as the Java examples. -->
                        <arg>-java-output-version:27</arg>
                    </args>
                    <!-- The plugin also runs javac over the Java sources in mixed mode, so it needs the preview flag too. -->
                    <javacArgs>
                        <arg>--enable-preview</arg>
                    </javacArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-scala</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Ahead-of-time compiles the Clojure namespaces under src/main/clojure into target/classes, before Juno runs. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>compile-clojure</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>clojure.main</mainClass>
                            <!-- Clojure is a provided dependency, so the compile scope (not runtime) puts it on the classpath. -->
                            <classpathScope>compile</classpathScope>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.basedir}/src/main/clojure</additionalClasspathElement>
                            </additionalClasspathElements>
                            <arguments>
                                <argument>${project.basedir}/clojure-aot/compile-namespaces.clj</argument>
                                <argument>${project.basedir}/src/main/clojure</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.jabrena</groupId>
                <artifactId>juno-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <mainClass>${juno.main}</mainClass>
                    <envFile>${juno.envFile}</envFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>env</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Compile the language examples with the real arduino-cli in Docker (LanguageExamplesArduinoCliIT). -->
        <profile>
            <id>arduino-cli</id>
            <properties>
                <!-- How many sketches LanguageExamplesArduinoCliIT compiles at once; override with -Djuno.arduinoCliParallelism. -->
                <juno.arduinoCliParallelism>4</juno.arduinoCliParallelism>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>arduino-cli</groups>
                            <properties>
                                <configurationParameters>
                                    junit.jupiter.execution.parallel.enabled = true
                                    junit.jupiter.execution.parallel.config.strategy = fixed
                                    junit.jupiter.execution.parallel.config.fixed.parallelism = ${juno.arduinoCliParallelism}
                                </configurationParameters>
                            </properties>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/*Test.java</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
