<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>java-for-arduino</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juno-examples</artifactId>
    <name>Juno Arduino Examples</name>
    <description>Example Java programs demonstrating the Juno hardware API</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <juno.main>io.github.jabrena.juno.api.Blink</juno.main>
        <juno.envFile>${maven.multiModuleProjectDirectory}/.env</juno.envFile>
        <kotlin.version>2.2.20</kotlin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-rcx-firmware</artifactId>
        </dependency>
        <!-- Kotlin examples compile against the Juno API only; the stdlib is needed at build time, never on the board. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Nullability annotations are never read by the board toolchain; the class is Java 5 bytecode Juno rejects. -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Tests drive the compiler directly (JunoCompiler, CompilationRequest) on the example classes. -->
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-compiler</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Only LanguageExamplesArduinoCliIT (the arduino-cli profile) uses these; versions come from the root pom. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Pulled in through duct-tape: compile-time nullability annotations the test runtime never reads. -->
                <exclusion>
                    <groupId>org.jetbrains</groupId>
                    <artifactId>annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                    </sourceDirs>
                    <jvmTarget>24</jvmTarget>
                    <args>
                        <!-- Keep the bytecode Juno lowers free of kotlin.jvm.internal.Intrinsics calls. -->
                        <arg>-Xno-param-assertions</arg>
                        <arg>-Xno-call-assertions</arg>
                        <arg>-Xno-receiver-assertions</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-kotlin</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.jabrena</groupId>
                <artifactId>juno-maven-plugin</artifactId>
                <version>${project.version}</version>
                <configuration>
                    <mainClass>${juno.main}</mainClass>
                    <envFile>${juno.envFile}</envFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>env</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Compile the language examples with the real arduino-cli in Docker (LanguageExamplesArduinoCliIT). -->
        <profile>
            <id>arduino-cli</id>
            <properties>
                <!-- How many sketches LanguageExamplesArduinoCliIT compiles at once; override with -Djuno.arduinoCliParallelism. -->
                <juno.arduinoCliParallelism>4</juno.arduinoCliParallelism>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>arduino-cli</groups>
                            <properties>
                                <configurationParameters>
                                    junit.jupiter.execution.parallel.enabled = true
                                    junit.jupiter.execution.parallel.config.strategy = fixed
                                    junit.jupiter.execution.parallel.config.fixed.parallelism = ${juno.arduinoCliParallelism}
                                </configurationParameters>
                            </properties>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/*Test.java</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
