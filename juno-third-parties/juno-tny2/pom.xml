<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>juno-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>juno-tny2</artifactId>
    <name>Juno TNY2 Model Builder</name>
    <description>Trains, quantizes and exports TNY2 character-level transformer models, and generates the flash image that board programs load into PSRAM</description>

    <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- NullAway (via Error Prone) checks the host-side model builder. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>${nullaway.errorprone.arg}</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On demand only: trains JUNO.BIN from the bundled facts and generates its Tny2ModelImage into
             target/tny2; a default build never trains. CI only compiles juno-tny2; the model is never trained in CI.
             ./mvnw -pl juno-third-parties/juno-tny2 -Ptny2-model process-classes [-Dtny2.steps=3000]
             To release the result, copy target/tny2/JUNO.BIN to src/main/resources/tny2/ and
             target/tny2/Tny2ModelImage.java to src/main/java/io/github/jabrena/juno/thirdparty/tny2/. -->
        <profile>
            <id>tny2-model</id>
            <properties>
                <tny2.steps>3000</tny2.steps>
                <tny2.seed>1</tny2.seed>
                <tny2.minAccuracy>0.95</tny2.minAccuracy>
                <!-- The held-out questions in src/main/resources/tny2/heldout are never trained on; the profile keeps
                     the checkpoint that answers most of them and fails below this fraction. -->
                <tny2.minHeldOutAccuracy>0</tny2.minHeldOutAccuracy>
                <!-- TINY 2.1's shape: a 382 KB JUNO.BIN that runs on the Nano ESP32. The engine's largest shape is
                     -Dtny2.width=128 -Dtny2.layers=8 -Dtny2.hidden=512 (1.6 M parameters, 1.65 MB). -->
                <tny2.width>96</tny2.width>
                <tny2.layers>4</tny2.layers>
                <tny2.heads>4</tny2.heads>
                <tny2.hidden>256</tny2.hidden>
                <tny2.outputDirectory>${project.build.directory}/tny2</tny2.outputDirectory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>io.github.jabrena.juno.tny2.cli.Tny2Builder</mainClass>
                            <!-- Tny2Builder exits with 1 on a model below the accuracy gate; fail the build instead. -->
                            <blockSystemExit>true</blockSystemExit>
                        </configuration>
                        <executions>
                            <execution>
                                <id>train-model</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>train</argument>
                                        <argument>${project.basedir}/src/main/resources/tny2/facts</argument>
                                        <argument>${tny2.outputDirectory}/JUNO.BIN</argument>
                                        <argument>--steps</argument>
                                        <argument>${tny2.steps}</argument>
                                        <argument>--seed</argument>
                                        <argument>${tny2.seed}</argument>
                                        <argument>--min-accuracy</argument>
                                        <argument>${tny2.minAccuracy}</argument>
                                        <argument>--width</argument>
                                        <argument>${tny2.width}</argument>
                                        <argument>--layers</argument>
                                        <argument>${tny2.layers}</argument>
                                        <argument>--heads</argument>
                                        <argument>${tny2.heads}</argument>
                                        <argument>--hidden</argument>
                                        <argument>${tny2.hidden}</argument>
                                        <argument>--held-out</argument>
                                        <argument>${project.basedir}/src/main/resources/tny2/heldout</argument>
                                        <argument>--min-held-out</argument>
                                        <argument>${tny2.minHeldOutAccuracy}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>generate-image</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>image</argument>
                                        <argument>${tny2.outputDirectory}/JUNO.BIN</argument>
                                        <argument>${tny2.outputDirectory}/Tny2ModelImage.java</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
