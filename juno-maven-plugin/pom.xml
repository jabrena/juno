<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jabrena</groupId>
        <artifactId>java-for-arduino</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juno-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Juno Arduino Maven Plugin</name>
    <description>Maven integration for compiling, verifying, uploading, and monitoring Juno Arduino programs</description>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-compiler</artifactId>
        </dependency>
        <!-- Only juno-compiler's transitive compile dependency in production code; declared explicitly, test
             scope, because CompileMojoTest/VerifyMojoTest/UploadMojoTest's fixture entry point imports it
             directly. -->
        <dependency>
            <groupId>io.github.jabrena</groupId>
            <artifactId>juno-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- lookupMojo/configureMojo + setVariableValueToObject: sets a Mojo's @Parameter fields the way Maven
             itself does, from a unit-test plugin-config.xml, instead of reflection written in test code. -->
        <dependency>
            <groupId>org.apache.maven.plugin-testing</groupId>
            <artifactId>maven-plugin-testing-harness</artifactId>
            <version>3.5.1</version>
            <scope>test</scope>
        </dependency>
        <!-- AbstractMojoTestCase's PlexusTestCase superclass is junit.framework.TestCase (JUnit 3); the harness
             declares this optional, so it must be supplied here. Not used for test discovery: tests run as
             ordinary JUnit Jupiter classes with @Test/@BeforeEach. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Only a transitive dependency of the harness above (it provides the Plexus container); declared
             explicitly, test scope, because MojoConfig builds each Mojo's configuration directly from its
             DefaultPlexusConfiguration/PlexusConfiguration, in pure Java, instead of an XML fixture file. -->
        <dependency>
            <groupId>org.eclipse.sisu</groupId>
            <artifactId>org.eclipse.sisu.plexus</artifactId>
            <version>1.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- EnvMojoTest exercises the real reflective export into java.lang.ProcessEnvironment, which needs
                 the same add-opens flags EnvMojo's own javadoc documents for the real Maven JVM (.mvn/jvm.config),
                 here applied to the forked Surefire JVM instead. @{argLine} keeps JaCoCo's instrumentation
                 argument (set by prepare-agent) rather than replacing it. Passing any other profile with -P
                 (e.g. -PclearTestCache) deactivates jacoco's activeByDefault profile, so prepare-agent never
                 runs and this placeholder is left unresolved; -Pjacoco,<otherProfile> keeps both active. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens
                        java.base/java.util=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- NullAway (via Error Prone) fails the build on nullness errors; settings live in the root pom. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>${nullaway.errorprone.arg}</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>juno</goalPrefix>
                    <requiredJavaVersion>${java.version}</requiredJavaVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
